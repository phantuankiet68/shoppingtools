enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum WebsiteType {
  landing
  blog
  ecommerce
  booking
  lms
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum PaymentSiteStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentSiteProvider {
  STRIPE
  PAYPAL
  MOMO
  VNPAY
  MANUAL
}

enum PaymentSiteMethod {
  CARD
  BANK_TRANSFER
  WALLET
  CASH
}

model Site {
  id              String      @id @default(cuid())

  name            String
  domain          String      @unique
  type            WebsiteType @default(ecommerce)
  category        String?     @db.VarChar(100)

  logoUrl         String?     @map("logo_url")
  faviconUrl      String?

  seoTitle        String?     @map("seo_title")
  seoDescription  String?     @map("seo_description") @db.Text

  contactEmail    String?
  contactPhone    String?

  ownerUserId     String      @map("owner_user_id")
  createdByUserId String?     @map("created_by_user_id")
  workspaceId     String?     @map("workspace_id")

  status          SiteStatus  @default(DRAFT)
  isPublic        Boolean     @default(false) @map("is_public")

  publishedAt     DateTime?   @map("published_at")

  themeConfig     Json?       @map("theme_config")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  owner           User        @relation("SiteOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy       User?       @relation("SiteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspace       Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscription    SiteSubscription?

  customers       Customer[]
  addresses       Address[]
  menuItems       MenuItem[]
  orders          Order[]
  orderItems      OrderItem[]
  fulfillments    Fulfillment[]

  pages           Page[]
  products        Product[]
  productVariants ProductVariant[]
  Brands          Brand[]
  Categories      Category[]

  storageIntegration StorageIntegration?
  storageLogs        StorageLog[]

  returnRequests ReturnRequest[]
  reviews        Review[]

  emailProviderConfig EmailProviderConfig?
  emailCampaigns      EmailCampaign[]
  emailSubscribers    EmailSubscriber[]
  emailLogs           EmailLog[]
  emailAnalyticsDailies EmailAnalyticsDaily[]
  subscribers         Subscriber[]

  users User[]
  payments Payment[]
  paymentSites PaymentSite[]

  @@index([ownerUserId])
  @@index([workspaceId])
  @@index([status])
  @@index([isPublic])
  @@index([publishedAt])
  @@index([type])

  @@map("sites")
}

model PricingPlan {
  id String @id @default(cuid())
  name String
  code String @unique
  description String?
  status PlanStatus @default(ACTIVE)
  price Decimal @db.Decimal(10,2)
  billingCycle BillingCycle
  maxPages Int
  maxProducts Int
  maxUsers Int
  canCustomDomain Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions SiteSubscription[]
  @@index([status])
  @@index([sortOrder])
}

model SiteSubscription {
  id String @id @default(cuid())
  siteId String @unique
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  planId String
  plan PricingPlan @relation(fields: [planId], references: [id])
  status SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle
  autoRenew Boolean @default(true)
  startedAt DateTime @default(now())
  trialEndsAt DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  nextBillingAt DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paymentSites PaymentSite[]
  @@index([status])
  @@index([nextBillingAt])
  @@index([currentPeriodEnd])
}

model PaymentSite {
  id String @id @default(cuid())

  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription SiteSubscription? @relation(fields: [subscriptionId], references: [id])

  amount Decimal @db.Decimal(10,2)
  currency String @default("USD")

  status PaymentSiteStatus
  provider PaymentSiteProvider
  method PaymentSiteMethod?

  transactionId String? @unique
  invoiceNumber String?
  receiptUrl String?

  description String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])

  @@map("payment_sites")
}